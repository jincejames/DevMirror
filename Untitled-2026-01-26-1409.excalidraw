      "isDeleted": false,
      "boundElements": [],
      "updated": 1773659509636,
      "link": null,
      "locked": false,
      "text": "3. ALL AGREED \nNo daily sync required, becuase\n already part of previously migrated streams \nand table produced within DBX. Stream 2 \nwill be running daily, hence table 2 is refreshed \ndaily or kept upto date. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. ALL AGREED \nNo daily sync required, becuase\n already part of previously migrated streams \nand table produced within DBX. Stream 2 \nwill be running daily, hence table 2 is refreshed \ndaily or kept upto date. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
