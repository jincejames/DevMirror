      "updated": 1773659542087,
      "link": null,
      "locked": false,
      "text": "2. ALL AGREED\nDirectly delivered by OIP\nWe read directly through external volume, no sync required\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. ALL AGREED\nDirectly delivered by OIP\nWe read directly through external volume, no sync required\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IKUECwDPZJj1OBq17EXaG",
      "type": "text",
      "x": 1663.078114947133,
      "y": 12580.444574294426,
      "width": 461.2796936035156,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
