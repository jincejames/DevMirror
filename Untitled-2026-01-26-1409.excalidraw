    {
      "id": "mVEvoEiaypZAgilQK7Wg-",
      "type": "text",
      "x": 2549.195112677102,
      "y": 12326.750207292862,
      "width": 927.1993408203125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9C",
      "roundness": null,
      "seed": 1378489497,
      "version": 670,
      "versionNonce": 471522893,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773661541608,
      "link": null,
      "locked": false,
      "text": "4. ALL AGREED \nDaily Sync required in Pre-Prod. Because table is produced\nourside DBX currently. A daily sync of table 3 is required until table 3 is\nproduced within DBX. The first execution of daily sync will be the \"initial sync\" for this table, \nsince all daily syncs are daily snapshots. \nThere will not be a separate initial sync for this type of tables/ scenarios.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. ALL AGREED \nDaily Sync required in Pre-Prod. Because table is produced\nourside DBX currently. A daily sync of table 3 is required until table 3 is\nproduced within DBX. The first execution of daily sync will be the \"initial sync\" for this table, \nsince all daily syncs are daily snapshots. \nThere will not be a separate initial sync for this type of tables/ scenarios.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "MkdtbsU3bdyZU-xxOo7S2",
      "type": "text",
      "x": 2352.330470132066,
      "y": 13140.883869827134,
      "width": 845.8594970703125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9D",
      "roundness": null,
      "seed": 1574725207,
      "version": 570,
      "versionNonce": 1838464449,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780305127423,
      "link": null,
      "locked": false,
      "text": "5. ALL AGREED \nNo daily sync required, becuase produced within DBX\nalso, data check will happen only as a high level metrics,\nNo row to row reconcilation. This high level metrics comparison will \nhappen directly with TD and Databricks, no snapshot sync or export.\nSelect count(*) from TD < compare with result of > Select count(*) from Databricks\nFor table 1 we will need a one time initial load becuase we will need the \"before state\" \nof table 1 before TD Stream 1 goes live on DBX.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5. ALL AGREED \nNo daily sync required, becuase produced within DBX\nalso, data check will happen only as a high level metrics,\nNo row to row reconcilation. This high level metrics comparison will \nhappen directly with TD and Databricks, no snapshot sync or export.\nSelect count(*) from TD < compare with result of > Select count(*) from Databricks\nFor table 1 we will need a one time initial load becuase we will need the \"before state\" \nof table 1 before TD Stream 1 goes live on DBX.",
      "autoResize": true,
      "lineHeight": 1.25
    },
