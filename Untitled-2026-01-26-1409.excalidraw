    {
      "id": "b-yNL3cMv0lEzNiowISFF",
      "type": "text",
      "x": 353.89510115586927,
      "y": 13294.258174973911,
      "width": 1298.663818359375,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9X",
      "roundness": null,
      "seed": 1751623001,
      "version": 390,
      "versionNonce": 2099407353,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773054886145,
      "link": null,
      "locked": false,
      "text": "1. - ALL AGREED\nCaveat: At the moment we may not have all the \npermissions required to read, but this is taken up\n\nDependent on ODP in deciding how to make \nPROD data available in Pre-Prod. \nProject team view: Pre-Prod is not same as Dev env, as pre-prod is close \nto PROD env and will not be used for development",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. - ALL AGREED\nCaveat: At the moment we may not have all the \npermissions required to read, but this is taken up\n\nDependent on ODP in deciding how to make \nPROD data available in Pre-Prod. \nProject team view: Pre-Prod is not same as Dev env, as pre-prod is close \nto PROD env and will not be used for development",
      "autoResize": true,
      "lineHeight": 1.25
    },
